      "namedRegex": "^/api/auth/signup(?:/)?$"
    },
    {
      "page": "/api/equipment/detect",
      "regex": "^/api/equipment/detect(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/equipment/detect(?:/)?$"
    },
    {
      "page": "/api/exercises",
      "regex": "^/api/exercises(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/exercises(?:/)?$"
    },
    {
      "page": "/api/plan",
      "regex": "^/api/plan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/plan(?:/)?$"
    },
    {
      "page": "/api/sessions",
      "regex": "^/api/sessions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/sessions(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/equipment",
      "regex": "^/equipment(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/equipment(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/onboarding",
      "regex": "^/onboarding(?:/)?$",
      "routeKeys": {},
